# ============================================================
# Markina Gallery — exemplo de variáveis de ambiente
# Copie para docker/.env (local) ou para o servidor (.env.homolog / .env.prod).
# NUNCA preencha este arquivo com segredos reais e nunca versione arquivos .env.
# ============================================================

# Ambiente
APP_ENV=development
DOMAIN=localhost

# Porta local publicada pelo Nginx. Em homologação, use 127.0.0.1:8080 para
# que apenas o Nginx Proxy Manager existente receba tráfego externo.
MARKINA_GALLERY_PORT=8080

# PostgreSQL (usado pelo docker-compose)
POSTGRES_USER=markina_gallery
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=markina_gallery
DATABASE_URL=postgresql+psycopg://markina_gallery:troque-esta-senha@db:5432/markina_gallery

# Redis
REDIS_URL=redis://redis:6379/0

# Segurança — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

# Autenticação (valores seguros e distintos por ambiente)
SESSION_COOKIE_NAME=markina_session
SESSION_DAYS=7
OTP_TTL_MINUTES=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=5
# Segredo HMAC exclusivo do ambiente; obrigatório fora de development.
AUTH_PII_FINGERPRINT_SALT=troque-por-um-segredo-aleatorio-exclusivo
AUTH_OTP_PII_RETENTION_MINUTES=60
AUTH_OTP_CLEANUP_INTERVAL_SECONDS=60
# Origem da API para desenvolvimento sem Nginx (não definir no Compose de produção).
API_ORIGIN=http://127.0.0.1:8000
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_TOTP_SECRET=

# WhatsApp transacional. O sandbox não faz chamadas externas. Para Evolution,
# WHATSAPP_CREDENTIAL_ENV deve coincidir exatamente com APP_ENV e as credenciais
# devem ser próprias daquele ambiente. Configure somente um telefone do
# fotógrafo previamente verificado em E.164.
WHATSAPP_PROVIDER=sandbox
WHATSAPP_CREDENTIAL_ENV=development
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=
# URL exclusivamente interna; não use domínio público.
WHATSAPP_WEBHOOK_URL=http://api:8000/internal/whatsapp/webhook
WHATSAPP_WEBHOOK_SECRET=
# Chave AES-GCM urlsafe-base64 de exatamente 32 bytes, exclusiva do ambiente.
WHATSAPP_OTP_ENCRYPTION_KEY=
WHATSAPP_PHOTOGRAPHER_PHONE_E164=
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_TIMEOUT_SECONDS=10
WHATSAPP_AMBIGUOUS_RETRY_AFTER_SECONDS=300

# Perfil real isolado. Só ative depois do inventário/deploy aprovado.
# COMPOSE_PROFILES=whatsapp-real
EVOLUTION_POSTGRES_USER=markina_evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_POSTGRES_DB=markina_evolution

# Mídia privada: volumes Docker exclusivos da Markina. O texto fica incorporado
# somente na prévia entregue ao cliente; originais não são expostos pela web.
MEDIA_WATERMARK_TEXT=MARKINA • PRÉVIA
# Vazio preserva a mídia histórica; só defina um inteiro positivo após decisão
# documentada do controlador dos dados.
COMMERCIAL_HISTORY_MEDIA_RETENTION_DAYS=

