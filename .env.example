# ============================================================
# Markina Gallery — exemplo de variáveis de ambiente
# Copie para docker/.env (local) ou para o servidor (.env.homolog / .env.prod).
# NUNCA preencha este arquivo com segredos reais e nunca versione arquivos .env.
# ============================================================

# Ambiente
APP_ENV=development
DOMAIN=localhost

# Porta local publicada pelo Nginx. Em homologação, use 127.0.0.1:8080 para
# que apenas o Nginx Proxy Manager existente receba tráfego externo.
MARKINA_GALLERY_PORT=8080

# PostgreSQL (usado pelo docker-compose)
POSTGRES_USER=markina_gallery
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=markina_gallery
DATABASE_URL=postgresql+psycopg://markina_gallery:troque-esta-senha@db:5432/markina_gallery

# Redis
REDIS_URL=redis://redis:6379/0

# Segurança — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

# Autenticação (valores seguros e distintos por ambiente)
SESSION_COOKIE_NAME=markina_session
SESSION_DAYS=7
OTP_TTL_MINUTES=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=5
# Segredo HMAC exclusivo do ambiente; obrigatório fora de development.
AUTH_PII_FINGERPRINT_SALT=troque-por-um-segredo-aleatorio-exclusivo
# Chave HMAC exclusiva para links reconstruíveis de galerias. MUST ser
# diferente de AUTH_PII_FINGERPRINT_SALT e possuir ao menos 32 bytes.
GALLERY_CAPABILITY_SIGNING_KEY=troque-por-outra-chave-aleatoria-exclusiva
AUTH_OTP_PII_RETENTION_MINUTES=60
AUTH_OTP_CLEANUP_INTERVAL_SECONDS=60
# Origem da API para desenvolvimento sem Nginx (não definir no Compose de produção).
API_ORIGIN=http://127.0.0.1:8000
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_TOTP_SECRET=

# WhatsApp transacional. O sandbox não faz chamadas externas. Para Evolution,
# WHATSAPP_CREDENTIAL_ENV deve coincidir exatamente com APP_ENV e as credenciais
# devem ser próprias daquele ambiente. Configure somente um telefone do
# fotógrafo previamente verificado em E.164.
WHATSAPP_PROVIDER=sandbox
WHATSAPP_CREDENTIAL_ENV=development
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=
# URL exclusivamente interna; não use domínio público.
WHATSAPP_WEBHOOK_URL=http://api:8000/internal/whatsapp/webhook
WHATSAPP_WEBHOOK_SECRET=
# Chave AES-GCM urlsafe-base64 de exatamente 32 bytes, exclusiva do ambiente.
WHATSAPP_OTP_ENCRYPTION_KEY=
WHATSAPP_PHOTOGRAPHER_PHONE_E164=
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_TIMEOUT_SECONDS=10
WHATSAPP_AMBIGUOUS_RETRY_AFTER_SECONDS=300

# E-mail transacional administrativo. `sandbox` nunca abre rede nem entrega
# mensagens. Para SMTP real, todas as credenciais devem pertencer ao APP_ENV.
EMAIL_PROVIDER=sandbox
EMAIL_CREDENTIAL_ENV=development
# Chave AES-GCM urlsafe-base64 de exatamente 32 bytes, exclusiva do ambiente.
EMAIL_PAYLOAD_ENCRYPTION_KEY=
# Origem canônica dos links; HTTPS é obrigatório fora de development.
PUBLIC_APP_ORIGIN=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TIMEOUT_SECONDS=10
SMTP_IMPLICIT_TLS=false
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_SECONDS=2
EMAIL_PROCESSING_TIMEOUT_SECONDS=120
ADMIN_SECURITY_CLEANUP_INTERVAL_SECONDS=60

# Perfil real isolado. Só ative depois do inventário/deploy aprovado.
# COMPOSE_PROFILES=whatsapp-real
EVOLUTION_POSTGRES_USER=markina_evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_POSTGRES_DB=markina_evolution

# Mídia privada: volumes Docker exclusivos da Markina. O texto fica incorporado
# somente na prévia entregue ao cliente; originais não são expostos pela web.
MEDIA_WATERMARK_TEXT=MARKINA • PRÉVIA
# Vazio preserva a mídia histórica; só defina um inteiro positivo após decisão
# documentada do controlador dos dados.
COMMERCIAL_HISTORY_MEDIA_RETENTION_DAYS=

# Filtro facial privado. Permanece desligado até que todos os gates jurídicos,
# criptográficos e operacionais sejam preenchidos para o mesmo APP_ENV. O
# runtime facial é isolado e não publica portas. Não copie chaves reais para Git.
# Kill switch técnico: mantenha false por padrão e no primeiro deploy de produção.
# A flag true não autoriza galerias; rollout persistido e gates continuam obrigatórios.
FACIAL_PROCESSING_ENABLED=false
FACIAL_CREDENTIAL_ENV=development
FACIAL_MODEL_MANIFEST_PATH=/app/facial-assets/model-manifest.json
FACIAL_MODEL_ROOT=/opt/markina-face-models
FACIAL_REFERENCE_ROOT=/var/lib/markina/facial-references
MARKINA_PUBLIC_URL=http://localhost:3000
FACIAL_REDIS_URL=redis://redis:6379/0
FACIAL_MODEL_VERSION=yunet-2023mar+sface-2021dec
FACIAL_QUALITY_VERSION=opencv-technical-v1
# Versões e referências são públicas/opacas; segredos e evidências não entram neste arquivo.
FACIAL_CALIBRATION_VERSION=
FACIAL_LEGAL_NOTICE_VERSION=
FACIAL_CONSENT_VERSION=
FACIAL_LEGAL_BASIS_REFERENCE=
FACIAL_RETENTION_POLICY_VERSION=
FACIAL_MINOR_POLICY_VERSION=
FACIAL_SIMILARITY_THRESHOLD_MILLI=750
# JSON de key-id para chave AES-256 urlsafe-base64; mantenha chaves antigas
# durante a rotação até que todos os envelopes correspondentes sejam eliminados.
FACIAL_AEAD_ACTIVE_KEY_ID=
FACIAL_AEAD_KEYS_JSON=
# Tetos normativos: referência por no máximo 15 min; candidatas por 24 h.
FACIAL_REFERENCE_RETENTION_SECONDS=900
FACIAL_CANDIDATE_RETENTION_SECONDS=86400
FACIAL_QUEUE_NAME=markina:facial:jobs
FACIAL_WORKER_CONCURRENCY=1
FACIAL_MAX_JOBS_PER_PROCESS=100
FACIAL_MODEL_IDLE_SECONDS=300
FACIAL_JOB_LEASE_SECONDS=120
FACIAL_QUEUE_BLOCK_SECONDS=10
FACIAL_MAX_REFERENCE_BYTES=10485760
FACIAL_MAX_REFERENCE_PIXELS=25000000

# ------------------------------------------------------------
# Integrações futuras (documentadas; ainda sem uso no scaffolding):
# GOOGLE_DRIVE_FOLDER_ID=
# ------------------------------------------------------------
