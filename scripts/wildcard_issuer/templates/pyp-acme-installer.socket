[Unit]
Description=Pick-your-Pic restricted wildcard installer socket
ConditionPathExists=/etc/pyp-acme-issuer/installer.json

[Socket]
ListenStream=/run/pyp-acme-installer/installer.sock
SocketUser=root
SocketGroup=pyp-acme
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true

# Sem [Install]; iniciar exige autorização operacional específica.
